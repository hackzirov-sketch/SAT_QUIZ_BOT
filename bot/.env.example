BOT_TOKEN=1234567890:replace_with_botfather_token
ADMIN_IDS=123456789,987654321
DATABASE_PATH=data/quiz_bot.db
VOCABULARY_PATH=data/vocabulary.json
PORT=5000
TZ=Asia/Tashkent
LOG_LEVEL=INFO
BOT_POLLING_ENABLED=1

# Webhook mode. Leave empty for polling.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Production tuning.
DB_BUSY_TIMEOUT_MS=5000
SUBSCRIPTION_CACHE_TTL=600
SUBSCRIPTION_STRICT=0
SESSION_SWEEP_INTERVAL=10

# Weekly group report schedule. 0=Monday, 6=Sunday.
WEEKLY_REPORT_ENABLED=1
WEEKLY_REPORT_WEEKDAY=0
WEEKLY_REPORT_HOUR=9
WEEKLY_REPORT_MINUTE=0
